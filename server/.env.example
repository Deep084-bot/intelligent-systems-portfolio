# ---------------------------------------------------------------------------
# Server environment (names + descriptions only; never commit real secrets).
# Copy to server/.env and fill in values. Anything not set uses a safe default.
# ---------------------------------------------------------------------------

# HTTP port for the local Express server.
PORT=4000

# ----------------------------------------------------------------------------
# AI provider
# ----------------------------------------------------------------------------
# Which provider the assistant uses: "groq" (default) or "gemini".
AI_PROVIDER=groq

# Groq credential + model. GROQ_ENDPOINT is an optional override (tests use it
# to point at a mock endpoint); leave unset to use the public API.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_ENDPOINT=

# Gemini credential + model (only needed when AI_PROVIDER=gemini).
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-1.5-flash

# ----------------------------------------------------------------------------
# Persistent memory (owner-scoped)
# ----------------------------------------------------------------------------
# Server-configured owner namespace. Memory is enabled only for a namespace the
# server trusts; it is NEVER taken from a client-supplied userId.
MEMORY_NAMESPACE=
# Enables the owner memory HTTP surface (default off). A deployment must ALSO
# inject a verified owner identity; there is no in-app authentication.
MEMORY_OWNER_ENABLED=false
# Retention for stored memory in seconds. 0 (default) = no expiry.
MEMORY_RETENTION_SECONDS=0
# Optional namespace used only for the read-only status summary.
MEMORY_STATUS_NAMESPACE=

# ----------------------------------------------------------------------------
# Durable storage (Upstash Redis REST / Vercel KV)
# ----------------------------------------------------------------------------
# When BOTH a URL and a token are set, memory and cached data are written to
# durable Redis and survive serverless cold starts. If they are absent (or the
# backend is unreachable) the server falls back to an in-process, NON-durable
# Map and reports writes with durable:false.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV aliases (used when the UPSTASH_* vars are not set).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ----------------------------------------------------------------------------
# Tuning (optional)
# ----------------------------------------------------------------------------
# Per-window AI request budget for the rate limiter.
RATE_LIMIT_AI=4
# TTL (seconds) for cached project metadata.
PROJECT_CACHE_TTL=3600
